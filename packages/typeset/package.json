{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/typeset",
  "version": "0.4.0",
  "description": "Text measurement and line breaking. The subpath ./fonts reads font tables and gives widths, ./measurer gives the advance function of a layout, ./breaking has the line breakers, ./hyphen has hyphen patterns for each language, ./segmentation has the break positions of Unicode, ./bidi has the bidirectional algorithm of Unicode, and ./text has a rope.",
  "keywords": [
    "typeset",
    "line-breaking",
    "knuth-plass",
    "text-layout",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/typeset#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/typeset/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/typeset.git",
    "directory": "packages/typeset"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./breaking": "./src/breaking.ts",
    "./fonts": "./src/fonts.ts",
    "./fonts/inspect": "./src/fonts-inspect.ts",
    "./hyphen": "./src/hyphen.ts",
    "./hyphen/en-us": "./src/hyphen/en-us.ts",
    "./hyphen/de": "./src/hyphen/de.ts",
    "./hyphen/fr": "./src/hyphen/fr.ts",
    "./measurer": "./src/measurer.ts",
    "./bidi": "./src/bidi.ts",
    "./segmentation": "./src/segmentation.ts",
    "./text": "./src/text.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/report.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./breaking": {
        "types": "./build/breaking.d.ts",
        "default": "./build/breaking.js"
      },
      "./fonts": {
        "types": "./build/fonts.d.ts",
        "default": "./build/fonts.js"
      },
      "./fonts/inspect": {
        "types": "./build/fonts-inspect.d.ts",
        "default": "./build/fonts-inspect.js"
      },
      "./hyphen": {
        "types": "./build/hyphen.d.ts",
        "default": "./build/hyphen.js"
      },
      "./hyphen/en-us": {
        "types": "./build/hyphen/en-us.d.ts",
        "default": "./build/hyphen/en-us.js"
      },
      "./hyphen/de": {
        "types": "./build/hyphen/de.d.ts",
        "default": "./build/hyphen/de.js"
      },
      "./hyphen/fr": {
        "types": "./build/hyphen/fr.d.ts",
        "default": "./build/hyphen/fr.js"
      },
      "./measurer": {
        "types": "./build/measurer.d.ts",
        "default": "./build/measurer.js"
      },
      "./bidi": {
        "types": "./build/bidi.d.ts",
        "default": "./build/bidi.js"
      },
      "./segmentation": {
        "types": "./build/segmentation.d.ts",
        "default": "./build/segmentation.js"
      },
      "./text": {
        "types": "./build/text.d.ts",
        "default": "./build/text.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/collections": "^0.10.0",
    "@mark1russell7/rigor-generators": "^0.1.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/layout-contract": "^0.5.3",
    "@types/node": "^26.6.5",
    "@typeset/corpus": "workspace:*",
    "@vitest/coverage-v8": "^5.0.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
