{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/typeset",
  "version": "0.1.0",
  "description": "Text measurement and line breaking. The subpath ./breaking has the greedy, total fit and balanced line breakers, for any width function.",
  "keywords": [
    "typeset",
    "line-breaking",
    "knuth-plass",
    "text-layout",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/typeset#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/typeset/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/typeset.git",
    "directory": "packages/typeset"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./breaking": "./src/breaking.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/report.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./breaking": {
        "types": "./build/breaking.d.ts",
        "default": "./build/breaking.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.2",
    "@mark1russell7/layout-contract": "^0.3.2",
    "@types/node": "^26.6.5",
    "@typeset/corpus": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
