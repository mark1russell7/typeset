{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mark1russell7/cue/ts/config/ts.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false
  },
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/**/*.spec.ts",
    "${configDir}/**/*.test.ts",
    "${configDir}/src/**/report.ts"
  ]
}
