{
  "$schema": "https://json.schemastore.org/package",
  "name": "@typeset/conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hyphen/records": "./src/hyphen/records.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "conformance": "node src/main.ts",
    "tables": "node src/main.ts --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "draw": "node src/hyphen/draw.ts",
    "train": "node src/hyphen/train-main.ts"
  },
  "dependencies": {
    "@mark1russell7/rigor-statistics": "^0.1.27",
    "@mark1russell7/typeset": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-generators": "^0.1.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
