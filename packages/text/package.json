{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/text",
  "version": "0.0.1",
  "description": "Plain text helpers. The first group is the escapes: escapeHtml, escapeAttribute, escapeRegExp and escapeMarkdown.",
  "keywords": [
    "text",
    "escape",
    "html",
    "regexp",
    "markdown",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/text#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/text/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/text.git",
    "directory": "packages/text"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-generators": "^0.1.8",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
