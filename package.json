{
  "$schema": "https://json.schemastore.org/package",
  "name": "typeset-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "conformance": "pnpm --filter @typeset/conformance conformance",
    "test": "pnpm -r run test && pnpm run test:actions",
    "test:actions": "node --test \".github/actions/*.test.ts\"",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint:ste": "ste-lint",
    "check:boundaries": "depcruise --config .dependency-cruiser.ts packages",
    "check:api": "api-report check",
    "check:conventions": "conventions check",
    "bench": "pnpm --filter @typeset/bench run bench",
    "weight": "pnpm --filter @typeset/bench run weight"
  },
  "devDependencies": {
    "@mark1russell7/template-cli": "^0.1.4",
    "@mark1russell7/api-report": "^0.5.0",
    "@mark1russell7/boundaries": "^0.2.0",
    "@mark1russell7/conventions": "^0.41.2",
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/ste-lint": "^0.3.0",
    "@swc/core": "^1.15.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
